# --- Database (PostgreSQL) ---
# Local dev: `docker compose up postgres -d` (or any Postgres you already run),
# then create a database/role and point this at it. See README for details.
DATABASE_URL="postgresql://utilityscout:utilityscout@localhost:5432/utilityscout"

# --- DexScreener discovery ---
DEXSCREENER_BASE_URL="https://api.dexscreener.com"
TARGET_CHAIN_ID="robinhood"
DISCOVERY_INTERVAL_SECONDS=15
# Shared throttle for DexScreener calls across discovery, market refresh,
# awaiting-profile checks, and narrative scans. Raise if 429s persist.
DEXSCREENER_MIN_REQUEST_INTERVAL_MS=1000
HTTP_429_DEFAULT_COOLDOWN_MS=30000

# --- Robinhood Chain (EVM chainId 4663, Arbitrum Orbit rollup) ---
RH_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
# Optional comma-separated paid/archive RPCs, tried after RH_RPC_URL and before
# the rate-limited public fallback. Robinhood's docs list Alchemy support:
# https://robinhood-mainnet.g.alchemy.com/v2/{API_KEY}
RH_RPC_EXTRA_URLS=
RH_EXPLORER_API_URL="https://robinhoodchain.blockscout.com/api/v2"

# --- Solana (optional second chain, off by default — see config.ts's
# enabledChains/solanaTradingEnabled). QuickNode's free tier prices
# getProgramAccounts rather than blocking it (unlike PublicNode/the
# anonymous public RPC, both confirmed to reject it without a paid/personal
# token) — see solanaHolderConcentration.ts's doc comment.
# ENABLED_CHAINS=robinhood,solana
SOLANA_RPC_URL=
SOLANA_WALLET_PRIVATE_KEY=
SOLANA_TRADING_ENABLED=false

# --- Arc (Circle's new EVM L1, chain id 5042) — observation-only, off by
# default. Never wired into ENABLED_CHAINS/the real pipeline: it would be
# discovered and scored but then permanently rejected by honeypotCheck.ts,
# which hard fails-closed for any chain besides TARGET_CHAIN_ID/"solana".
# Day-one launchpad volume (Tolly/ArcPad/Flipt, mainnet launched 2026-09-16)
# is also confirmed closed-test-environment activity, not proven organic
# demand. This just emails when a real Arc launch clears an activity bar —
# see arcObserve.ts.
ARC_OBSERVATION_ENABLED=false
ARC_OBSERVATION_INTERVAL_SECONDS=60
ARC_OBSERVATION_MIN_LIQUIDITY_USD=10000
ARC_OBSERVATION_MIN_VOLUME_1H_USD=5000
ARC_OBSERVATION_CANDIDATE_EXPIRY_HOURS=12

# When eth_getLogs/pool discovery is rate-limited, cool down per token/entry
# instead of repeatedly hammering the same provider and blocking the queue.
POOL_DISCOVERY_INFRA_COOLDOWN_MS=60000
PENDING_ENTRY_INFRA_COOLDOWN_MS=60000

# --- Tracked creator/smart wallets ---
# Uses RPC Transfer logs filtered by wallet address. Signals feed discovery,
# research, and planning, but never bypass deterministic trade-risk gates.
WALLET_TRACKING_ENABLED=true
WALLET_TRACKING_INTERVAL_SECONDS=15
WALLET_TRACKING_BATCH_BLOCKS=500
WALLET_TRACKING_INITIAL_BACKFILL_BLOCKS=3000

# --- AI provider (Gemini) ---
# Get a key at https://aistudio.google.com/apikey. GEMINI_API_KEY_2/_3 are
# optional extra free-tier keys (e.g. from separate Google accounts/projects)
# — each has its own independent daily quota, so provider.ts rotates to the
# next one automatically the moment the current key hits a 429/quota-exhausted
# error, instead of the whole classify/research pipeline stalling for a day.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
CLASSIFIER_MODEL="gemini-flash-lite-latest"
RESEARCH_MODEL="gemini-flash-lite-latest"
# Note: on a free-tier key, "-pro" models have zero quota and "gemini-flash-latest"
# resolves to a preview model with a 20-requests/day quota (confirmed live) —
# both are unusable for a 24/7 agent until billing is enabled on the
# underlying Google Cloud project. Once it is, RESEARCH_MODEL can move to
# something stronger (e.g. "gemini-pro-latest" or "gemini-flash-latest") for
# better research quality.

# --- Email alerts (SMTP via nodemailer) ---
# Free option: a Gmail account + an App Password
# (https://myaccount.google.com/apppasswords, requires 2FA on the account) —
# 500 sends/24hr on a regular Gmail account, 2000/24hr on Google Workspace.
# SMTP_USER is the full mailbox address; SMTP_PASS is the 16-char App
# Password, not the account login password. Point SMTP_HOST/SMTP_PORT at a
# different provider if you'd rather not use Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# With Gmail SMTP, the From address must be SMTP_USER itself (or a verified
# "Send As" alias on that Gmail account) — Gmail silently rewrites anything
# else to the authenticated address.
ALERT_EMAIL_FROM="UtilityScout <you@gmail.com>"
ALERT_EMAIL_TO="you@example.com"
# Resend (https://resend.com), used ahead of SMTP when set: comma-separated
# keys, highest priority first, each from its own free account (100/day,
# 3,000/month); the next key takes over when one hits a limit. A single
# RESEND_API_KEY is also accepted and tried last. Without a verified domain,
# each account can only email the address it was registered with, so
# register every account to ALERT_EMAIL_TO.
RESEND_API_KEYS=
# RESEND_FROM="UtilityScout <onboarding@resend.dev>"

# --- Filtering thresholds ---
# User directive 2026-09-18: utility tokens only, no memecoins — tightened
# back from a prior loosening (0.45/0.7) that let almost anything short of an
# overwhelming meme verdict through, in the name of not missing momentum
# plays. That's the posture this reverses: a token reading as meme-branded
# should fail here, full stop, even if it's actively trading.
MIN_UTILITY_PROBABILITY=0.65
MAX_MEME_PROBABILITY=0.35
MIN_BRANDING_SCORE=0.35

# Real, already-observed trading demand — no longer a gate bypass anywhere in
# the pipeline (see MOMENTUM_OVERRIDE_MIN_LIQUIDITY_USD's removal). Kept only
# as an entry-timing signal in planning.ts (isExtremeMomentum: chase now vs.
# wait for a pullback) for candidates that already cleared the utility gate.
MOMENTUM_OVERRIDE_MIN_HOURLY_TXNS=20

# Lowered from 70: real weighted scores are structurally dragged down for
# genuinely early, legitimate projects by factors that lag reality (social,
# team, branding, holders — the last permanently pinned at 50, no data
# source) even when utility/contract/liquidity/market are all strong.
# Confirmed live: COPY scored 68.2 (contract 100, liquidity 100, market 86.8,
# website 85, but utility 55/social 40/branding 30/team 35 dragged the
# weighted average under the old 70 bar) and ran to $203K mcap (+295% 24h,
# ~3.5x from where we'd have caught it) within the hour of being rejected.
WATCHLIST_THRESHOLD=60
ALERT_THRESHOLD=85
MIN_CONFIDENCE_TO_ALERT=55

MIN_LIQUIDITY_USD=8000
MIN_LIQUIDITY_TO_MCAP_RATIO=0.04

# --- Timeouts ---
WEBSITE_TIMEOUT_MS=15000
RESEARCH_TIMEOUT_MS=120000

# --- Re-research throttle ---
RESEARCH_COOLDOWN_HOURS=6

# --- HTTP API ---
API_PORT=3000
API_KEY=

NODE_ENV=development
LOG_LEVEL=info

# =============================================================================
# Trading extension — see README's "Trading extension" section.
# TRADING_MODE=SHADOW (default) or PAPER never touch a wallet at all.
# TRADING_MODE=LIVE requires BOT_WALLET_PRIVATE_KEY below and fails closed at
# startup if it's missing — read the README before ever setting this.
# =============================================================================
TRADING_MODE=SHADOW
TRADING_ENABLED=true

# --- LIVE mode only (ignored entirely in PAPER/SHADOW) ---
# The private key for a DEDICATED bot wallet — never your main wallet. Never
# logged, never returned by any API endpoint, read only by src/trading/live/wallet.ts.
BOT_WALLET_PRIVATE_KEY=
# Verified Uniswap V4 Universal Router address on Robinhood Chain (chain ID
# 4663) — only override if Uniswap redeploys; a signing attempt to any other
# address is refused regardless of what this is set to elsewhere in the code.
ALLOWED_ROUTER_ADDRESSES=0x8876789976decbfcbbbe364623c63652db8c0904
# Pause new entries (exits still work) if the wallet's native ETH balance
# drops below this — needs enough left over for gas after a trade.
MIN_GAS_BALANCE_ETH=0.002
# Solana counterpart, only checked when SOLANA_TRADING_ENABLED=true.
MIN_GAS_BALANCE_SOL=0.02

# Candidate eligibility gates (on top of the base pipeline's own WATCHLIST/
# ALERT thresholds above). Tightened after the 2026-09-14 loss review: the
# bot should sit out rather than force trades in low-quality/meme flow.
MIN_TRADE_QUALITY_SCORE=80
MIN_TRADE_RESEARCH_CONFIDENCE=65
MIN_TRADE_CONTRACT_SCORE=75
MIN_TRADE_LIQUIDITY_USD=8000
MOMENTUM_TACTICAL_MIN_LIQUIDITY_USD=5000
UTILITY_ONLY_TRADING_ENABLED=true
MIN_TRADE_UTILITY_SCORE=70
MIN_TRADE_CREDIBILITY_SCORE=50
MIN_TRADE_WEBSITE_SCORE=45
REQUIRE_PRODUCT_FOR_TRADE=true
HONEYPOT_BYTECODE_CHECK_ENABLED=true

# Capital buckets and circuit breakers, all against the simulated paper
# balance below — there is no real wallet to reconcile against.
MIN_RESERVE_PERCENT=50
MAX_TOTAL_DEPLOYED_PERCENT=35
MAX_SINGLE_POSITION_PERCENT=25
# Small-account boost: below SMALL_ACCOUNT_EQUITY_USD of real equity, the
# single-position cap widens toward SMALL_ACCOUNT_MAX_SINGLE_POSITION_PERCENT
# instead of the steady-state MAX_SINGLE_POSITION_PERCENT above — gas is a
# much bigger proportional drag on a tiny account. Tapers back to steady
# state by LARGE_ACCOUNT_EQUITY_USD of equity.
SMALL_ACCOUNT_EQUITY_USD=50
LARGE_ACCOUNT_EQUITY_USD=300
SMALL_ACCOUNT_MAX_SINGLE_POSITION_PERCENT=40
MAX_OPEN_POSITIONS=2
MAX_DAILY_REALIZED_LOSS_PERCENT=20
MAX_CONSECUTIVE_LOSSES=3
# Modest discount vs. the fully-verified lane (see VERIFIED_LANE_SIZE_MULTIPLIER
# above), not a "probe" — every candidate reaching this lane already cleared
# the utility-only gate same as VERIFIED_PROJECT, just without hitting the
# highest score tier. TACTICAL_LIVE_MAX_POSITION_USD=0 means no hard dollar
# ceiling; sizing runs through the normal formula instead.
TACTICAL_LANE_SIZE_MULTIPLIER=0.75
TACTICAL_LIVE_MAX_POSITION_USD=0

# Narrative/trending-meta tactical lane — trades whatever DexScreener meta or
# X narrative is currently trending. Reopened 2026-09-20 (user directive):
# "trade memecoins THAT HAVE A REAL AND GOOD NARRATIVE behind them, not just
# any memecoin... you must check the tweet, see if it is a VERY GOOD and
# preferably VIRAL meme/concept before investing a penny in it." This does
# NOT touch the separate utility-only gate (UTILITY_ONLY_TRADING_ENABLED
# above) — utility tokens still go through that gate exactly as before; this
# lane is the ONLY place a memecoin can now reach live capital, and only
# after passing NARRATIVE_REQUIRE_AI_NARRATIVE_QUALITY below, which reads
# actual tweet text (not just tweet/account counts) and hard-rejects anything
# that isn't a genuinely good, organically viral concept. No tweet content to
# read = no trade, regardless of how strong the dex/market numbers look.
NARRATIVE_TRADING_ENABLED=true
NARRATIVE_POLL_INTERVAL_SECONDS=180
NARRATIVE_MAX_METAS_PER_POLL=8
NARRATIVE_MAX_PAIRS_PER_META=8
NARRATIVE_MAX_X_SEARCHES_PER_POLL=3
NARRATIVE_MIN_SCORE=68
NARRATIVE_MIN_LIQUIDITY_USD=8000
NARRATIVE_MIN_HOURLY_TXNS=20
NARRATIVE_MIN_BUY_RATIO_1H=0.5
NARRATIVE_MAX_BUY_RATIO_1H=0.88
NARRATIVE_MAX_VOLUME_TO_LIQUIDITY_1H=10
NARRATIVE_MIN_META_VOLUME_USD=1000000
NARRATIVE_MIN_META_LIQUIDITY_USD=250000
NARRATIVE_MIN_TOKEN_COUNT=3
# Guide heuristic: healthy organic trading turns over a meaningful fraction of
# market cap; far below that suggests a bundled/low-float token barely being
# traded among the same few wallets. See config.ts's comment for why this bar
# is much lower than the memecoin guide's own 80% (that figure is for a
# token's first hour on a bonding curve, not an already-trending meta).
NARRATIVE_MIN_VOLUME_TO_MCAP_RATIO_24H=0.15
# Hard gate: an AI reads real sample tweet text about the meta and must
# confirm it's a genuinely good, organically viral concept — not bot-scanner
# spam or a copycat of a better-known narrative. Kill switch only for an
# incident; this is the entire reason this lane is allowed to be on at all.
NARRATIVE_REQUIRE_AI_NARRATIVE_QUALITY=true
NARRATIVE_MIN_AI_VIRALITY_SCORE=60
NARRATIVE_LANE_SIZE_MULTIPLIER=0.15
NARRATIVE_LIVE_MAX_POSITION_USD=3.50
NARRATIVE_VOLUME_EXIT_AFTER_MINUTES=8
NARRATIVE_MIN_TXNS_5M_TO_HOLD=3
NARRATIVE_MIN_BUY_RATIO_5M_TO_HOLD=0.42
# Conservative mode: when either loss limit above trips, keep trading but only
# high-conviction setups (every threshold, and the evidence behind it, is in
# src/trading/config.ts). Entries fully pause again past these hard stops.
CONSERVATIVE_MODE_ENABLED=true
CONSERVATIVE_HARD_STOP_DAILY_LOSS_PERCENT=35
CONSERVATIVE_HARD_STOP_CONSECUTIVE_LOSSES=5

DEFAULT_ENTRY_PLAN_TTL_MINUTES=360
POSITION_MONITOR_INTERVAL_SECONDS=20
PENDING_ENTRY_MONITOR_INTERVAL_SECONDS=20
DEFAULT_MAX_HOLD_MINUTES=1440

# How often the AI re-analyzes a still-waiting candidate's target entry zone
# A backstop only — entryMonitor.ts replans immediately when price actually
# breaches the plan's own invalidation floor or do-not-chase ceiling. This
# only catches a plan gone stale without technically breaking either bound.
PENDING_PLAN_REVIEW_INTERVAL_MINUTES=20
PENDING_PLAN_REPLAN_ON_DRIFT_PERCENT=25
# The AI position-strategy review is now the only thing that ever takes
# profit on a live position (no more fixed multiples) — seconds, not
# minutes, so it reacts as the chart progresses. See config.ts's doc comment.
POSITION_STRATEGY_REVIEW_INTERVAL_SECONDS=30

DEFAULT_MAX_BUY_SLIPPAGE_BPS=300
DEFAULT_MAX_SELL_SLIPPAGE_BPS=500
EMERGENCY_MAX_SELL_SLIPPAGE_BPS=1000
MAX_BUY_PRICE_IMPACT_PERCENT=3
TACTICAL_PROBE_MAX_BUY_SLIPPAGE_BPS=1000
TACTICAL_PROBE_MAX_BUY_PRICE_IMPACT_PERCENT=10
MAX_GAS_COST_PERCENT_OF_POSITION=1.5
PAPER_ASSUMED_GAS_COST_USD=0.05

PAPER_STARTING_BALANCE_USD=1000
